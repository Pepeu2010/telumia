  "objective": "Move bounded cache-occupancy directory scans off budget callers and refresh Auto estimates after new measurements on Desktop and Android TV.",
  "implementation": {
    "scanExecutor": "One daemon executor per client; Java thread priority is one level below normal.",
    "refreshIntervalMillis": 15000,
    "refreshTrigger": "A scan is scheduled on the next occupancy query after the cached sample is older than the interval.",
    "callerBehavior": "Returns the latest known snapshot immediately. The first pending snapshot is zero bytes and incomplete, which is conservative until the scan finishes.",
